# =============================================================================
# golem-sample-unity — Unity 6 project (unity/)
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Patterns without a leading slash apply anywhere in the repository.
# =============================================================================

# --- Unity generated / cache -------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Autogenerated JetBrains Rider plugin (copied into Assets by the IDE)
[Aa]ssets/Plugins/Editor/JetBrains*

# Uncomment to ignore Asset Store tool exports
# [Aa]ssets/AssetStoreTools*

# Addressables build output
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# --- IDE / editor ------------------------------------------------------------
.vs/
.vscode/
.idea/
*.DotSettings.user
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Consulo
.consulo/

# --- Autogenerated Visual Studio / Rider solution files -----------------------
# Unity regenerates these when the project is opened.
*.csproj
*.unityproj
*.sln
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Build artifacts ---------------------------------------------------------
ExportedObj/
sysinfo.txt
crashlytics-build.properties

*.apk
*.aab
*.app
*.exe
*.unitypackage
*.unitypackage.meta

# --- OS junk -----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Misc --------------------------------------------------------------------
*.tmp
*.bak
*.swp
*~
*.orig

# Plastic SCM
.plastic/
*.private.0
*.private

# Gradle (Android builds)
.gradle/

# Local environment / secrets (never commit)
.env
.env.*
!.env.example
