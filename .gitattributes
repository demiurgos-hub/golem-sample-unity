# =============================================================================
# golem-sample-unity — Git LFS and Unity merge settings
# Requires Git LFS: https://git-lfs.com
# This repo already has LFS hooks installed (.git/hooks/*).
# =============================================================================

# Default: normalize line endings for text files.
* text=auto

# --- Unity YAML assets (text, smart-merge friendly) --------------------------
# Smart merge needs Unity's merge tool configured once per machine:
#   git config merge.unityyamlmerge.name "Unity Smart Merge (YAML, LF)"
#   git config merge.unityyamlmerge.driver \
#     '"<UNITY_PATH>/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %A %B %B %A" %A'
# Replace <UNITY_PATH> with your Unity 6 install directory.
*.unity         text merge=unityyamlmerge eol=lf
*.prefab        text merge=unityyamlmerge eol=lf
*.asset         text merge=unityyamlmerge eol=lf
*.mat           text merge=unityyamlmerge eol=lf
*.anim          text merge=unityyamlmerge eol=lf
*.controller    text merge=unityyamlmerge eol=lf
*.overrideController text merge=unityyamlmerge eol=lf
*.mask          text merge=unityyamlmerge eol=lf
*.playable      text merge=unityyamlmerge eol=lf
*.preset        text merge=unityyamlmerge eol=lf
*.spriteatlas   text merge=unityyamlmerge eol=lf
*.terrainlayer  text merge=unityyamlmerge eol=lf
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.inputactions  text eol=lf
*.shader        text eol=lf
*.cginc         text eol=lf
*.compute       text eol=lf
*.hlsl          text eol=lf
*.glslinc       text eol=lf
*.shadersubgraph text eol=lf
*.shadergraph   text eol=lf
*.meta          text merge=unityyamlmerge eol=lf

# --- Source code -------------------------------------------------------------
*.cs            text diff=csharp eol=lf
*.cs.meta       text eol=lf
